ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -pthread -B /mnt/workspace/zhy/Miniconda3/envs/vipe/compiler_compat -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /mnt/workspace/zhy/Miniconda3/envs/vipe/include -fPIC -O2 -isystem /mnt/workspace/zhy/Miniconda3/envs/vipe/include -fPIC -I/mnt/workspace/zhy/Miniconda3/envs/vipe/lib/python3.11/site-packages/torch/include -I/mnt/workspace/zhy/Miniconda3/envs/vipe/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -I/mnt/workspace/zhy/Miniconda3/envs/vipe/lib/python3.11/site-packages/torch/include/TH -I/mnt/workspace/zhy/Miniconda3/envs/vipe/lib/python3.11/site-packages/torch/include/THC -I/usr/local/cuda/include -I/mnt/workspace/zhy/Miniconda3/envs/vipe/include/python3.11 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/mnt/workspace/zhy/Miniconda3/envs/vipe/lib/python3.11/site-packages/torch/include -I/mnt/workspace/zhy/Miniconda3/envs/vipe/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -I/mnt/workspace/zhy/Miniconda3/envs/vipe/lib/python3.11/site-packages/torch/include/TH -I/mnt/workspace/zhy/Miniconda3/envs/vipe/lib/python3.11/site-packages/torch/include/THC -I/usr/local/cuda/include -I/mnt/workspace/zhy/Miniconda3/envs/vipe/include/python3.11 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -Xcompiler -fno-gnu-unique -I/mnt/workspace/zhy/TuLing/SceneCrafter_new/extern/MoSca/lib_render/gof-diff-gaussian-rasterization/third_party/glm/ -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_80,code=compute_80 -gencode=arch=compute_80,code=sm_80 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





