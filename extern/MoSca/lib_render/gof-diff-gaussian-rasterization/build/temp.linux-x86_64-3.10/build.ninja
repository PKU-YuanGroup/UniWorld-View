ninja_required_version = 1.3
cxx = /mnt/workspace/zhy/Miniconda3/envs/mosca/bin/x86_64-conda-linux-gnu-c++
nvcc = /mnt/workspace/zhy/Miniconda3/envs/mosca/bin/nvcc

cflags = -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /mnt/workspace/zhy/Miniconda3/envs/mosca/include -fPIC -O2 -isystem /mnt/workspace/zhy/Miniconda3/envs/mosca/include -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -ffunction-sections -pipe -isystem /mnt/workspace/zhy/Miniconda3/envs/mosca/include -DNDEBUG -D_FORTIFY_SOURCE=2 -O2 -isystem /mnt/workspace/zhy/Miniconda3/envs/mosca/include -fPIC -I/mnt/workspace/zhy/Miniconda3/envs/mosca/lib/python3.10/site-packages/torch/include -I/mnt/workspace/zhy/Miniconda3/envs/mosca/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/mnt/workspace/zhy/Miniconda3/envs/mosca/lib/python3.10/site-packages/torch/include/TH -I/mnt/workspace/zhy/Miniconda3/envs/mosca/lib/python3.10/site-packages/torch/include/THC -I/mnt/workspace/zhy/Miniconda3/envs/mosca/include -I/mnt/workspace/zhy/Miniconda3/envs/mosca/include/python3.10 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/mnt/workspace/zhy/Miniconda3/envs/mosca/lib/python3.10/site-packages/torch/include -I/mnt/workspace/zhy/Miniconda3/envs/mosca/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/mnt/workspace/zhy/Miniconda3/envs/mosca/lib/python3.10/site-packages/torch/include/TH -I/mnt/workspace/zhy/Miniconda3/envs/mosca/lib/python3.10/site-packages/torch/include/THC -I/mnt/workspace/zhy/Miniconda3/envs/mosca/include -I/mnt/workspace/zhy/Miniconda3/envs/mosca/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -Xcompiler -fno-gnu-unique -I/mnt/workspace/zhy/TuLing/MoSca/lib_render/gof-diff-gaussian-rasterization/third_party/glm/ -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_80,code=compute_80 -gencode=arch=compute_80,code=sm_80 -ccbin /mnt/workspace/zhy/Miniconda3/envs/mosca/bin/x86_64-conda-linux-gnu-cc -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags





build /mnt/workspace/zhy/TuLing/MoSca/lib_render/gof-diff-gaussian-rasterization/build/temp.linux-x86_64-3.10/cuda_rasterizer/backward.o: cuda_compile /mnt/workspace/zhy/TuLing/MoSca/lib_render/gof-diff-gaussian-rasterization/cuda_rasterizer/backward.cu
build /mnt/workspace/zhy/TuLing/MoSca/lib_render/gof-diff-gaussian-rasterization/build/temp.linux-x86_64-3.10/cuda_rasterizer/forward.o: cuda_compile /mnt/workspace/zhy/TuLing/MoSca/lib_render/gof-diff-gaussian-rasterization/cuda_rasterizer/forward.cu
build /mnt/workspace/zhy/TuLing/MoSca/lib_render/gof-diff-gaussian-rasterization/build/temp.linux-x86_64-3.10/cuda_rasterizer/rasterizer_impl.o: cuda_compile /mnt/workspace/zhy/TuLing/MoSca/lib_render/gof-diff-gaussian-rasterization/cuda_rasterizer/rasterizer_impl.cu
build /mnt/workspace/zhy/TuLing/MoSca/lib_render/gof-diff-gaussian-rasterization/build/temp.linux-x86_64-3.10/ext.o: compile /mnt/workspace/zhy/TuLing/MoSca/lib_render/gof-diff-gaussian-rasterization/ext.cpp
build /mnt/workspace/zhy/TuLing/MoSca/lib_render/gof-diff-gaussian-rasterization/build/temp.linux-x86_64-3.10/rasterize_points.o: cuda_compile /mnt/workspace/zhy/TuLing/MoSca/lib_render/gof-diff-gaussian-rasterization/rasterize_points.cu






